<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode's generated-Info.plist mechanism only honors a fixed whitelist of
	     INFOPLIST_KEY_* build settings, and UIBackgroundModes is not on it. Setting
	     INFOPLIST_KEY_UIBackgroundModes in the pbxproj resolves in the build
	     settings and is then silently dropped from the generated plist, so the app
	     ships with no audio background mode and iOS suspends it the moment the
	     screen locks. This partial plist supplies the key for real. Every other
	     Info.plist key is still generated: GENERATE_INFOPLIST_FILE stays YES and
	     Xcode merges its output on top of this file. -->
	<!-- iOS blocks cleartext HTTP by default, which includes a backend running on
	     the development machine. NSAllowsLocalNetworking is the narrow exception for
	     exactly that: it permits unqualified hostnames, *.local and link-local
	     addresses, and nothing on the public internet. Broader ATS exceptions would
	     also allow plain HTTP to arbitrary domains, which is not the trade here. -->
	<!-- ASWebAuthenticationSession intercepts its own callback, so Cognito needed
	     no registered scheme. Spotify's SDK app-switches to the Spotify app, which
	     calls back through openURL, and that does require the scheme to be declared. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.obinnaduruaku.OmniMusik</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>omnimusik</string>
			</array>
		</dict>
	</array>
	<!-- Required before canOpenURL can report whether Spotify is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
